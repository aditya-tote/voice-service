# Do not log $request_uri here: query-token mode would expose a credential.
server {
  listen 443 ssl http2;
  server_name bridge.example.com;
  ssl_certificate /etc/letsencrypt/live/bridge.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/bridge.example.com/privkey.pem;
  location / { return 404; }
  location /calls/ {
    access_log off;
    error_log /dev/null crit;
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 3600s;
  }
  location = /webhooks/vih/cdr {
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 64k;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
  }
}
