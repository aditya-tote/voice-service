CONTROL_HOST=127.0.0.1
CONTROL_PORT=8080
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8081
PUBLIC_STREAM_BASE_URL=wss://bridge.example.com
BRIDGE_API_KEY=
# Structured operational logs written to stdout: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
# ViH connects using the one-use token in each generated WSS URL.
MEDIA_AUTH_MODE=query
SESSION_TTL_SECONDS=300
MAX_STORED_SESSIONS=1000
PERSONAPLEX_URL=ws://127.0.0.1:8998/api/chat
ALLOWED_VOICES=NATF2.pt
# Legacy callback settings are optional. Results are polled from /v1/calls/{id}.
CONTROLLER_CALLBACK_BASE_URL=http://127.0.0.1:9000
CONTROLLER_API_KEY=
DATABASE_PATH=voice-harness.sqlite3
VIH_DIAL_MODE=mock
ENABLE_LIVE_DIALS=false
VIH_OBD_URL=https://obd.voicensms.in/obd/OBDAPI/webresources/CreateOBDCampaignPost
VIH_UKEY=
VIH_SERVICE_NO=
# Template ID from the latest provider payload; override if your account uses another ID.
VIH_TEMPLATE_ID=200
VIH_PHONE_FORMAT=e164
# Required for live mode after account-approved purpose: 3 promotional or 4 transactional.
VIH_CAMPAIGN_TYPE=
# Latest provider contract: the generated full URL is sent in msisdnlist[].param1.
# Replace bridge.example.com in BOTH PUBLIC_STREAM_BASE_URL and this template.
# Keep {callId} and {token} literal; VAH fills them for each call.
VIH_WSS_VALUE_MODE=confirmed_dynamic
VIH_WSS_VALUE=wss://bridge.example.com/calls/{callId}?token={token}
# Optional completion-reporting integration. Leave disabled for the WSS-only audio demo.
VIH_CDR_AUTH_MODE=disabled
VIH_CDR_SECRET=
# Optional for WSS audio. Required with CDR when calls that never open a stream must be reconciled.
# Confirmed JSON Pointer to ViH's returned call ID, e.g. /data/callSid.
VIH_RESPONSE_CALL_ID_PATH=
# Alternatively, confirmed campaign ID JSON Pointer. Safe only because this POC sends one recipient per campaign.
VIH_RESPONSE_CAMPAIGN_ID_PATH=
RECORDING_DIR=
MAX_FRAME_BYTES=16384
MAX_TRANSCRIPT_CHARS=32768
PERSONAPLEX_READY_TIMEOUT_SECONDS=15
IDLE_TIMEOUT_SECONDS=60
CLOSE_TIMEOUT_SECONDS=5
MAX_CALL_SECONDS=1800
