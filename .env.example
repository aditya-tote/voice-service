CONTROL_HOST=127.0.0.1
CONTROL_PORT=8080
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8081
PUBLIC_STREAM_BASE_URL=wss://bridge.example.com
BRIDGE_API_KEY=
# Structured, masked operational logs written to stdout: DEBUG, INFO, WARNING, or ERROR.
# INFO already includes safe ViH request/response and WebSocket lifecycle summaries; no extra flag is needed.
# Raw provider payloads, messages, tokens and credentials are never logged.
LOG_LEVEL=INFO
# Temporary debugging: show destination phone and WSS address, with query secrets masked.
# Disable after debugging; logs contain personal data when enabled.
LOG_PROVIDER_DESTINATION=false
# ViH connects using the one-use token in each generated WSS URL.
MEDIA_AUTH_MODE=query
SESSION_TTL_SECONDS=300
MAX_STORED_SESSIONS=1000
PERSONAPLEX_URL=ws://127.0.0.1:8998/api/chat
ALLOWED_VOICES=NATF2.pt
# Service-owned outbound voice; must be a safe .pt filename in ALLOWED_VOICES.
DEFAULT_VOICE=NATF2.pt
# Legacy callback settings are optional. Results are polled from /v1/calls/{id}.
CONTROLLER_CALLBACK_BASE_URL=http://127.0.0.1:9000
CONTROLLER_API_KEY=
DATABASE_PATH=voice-harness.sqlite3
VIH_DIAL_MODE=mock
ENABLE_LIVE_DIALS=false
VIH_OBD_URL=https://obd.voicensms.in/obd/OBDAPI/webresources/CreateOBDCampaignPost
VIH_UKEY=
VIH_SERVICE_NO=
# Template ID from the latest provider payload; override if your account uses another ID.
VIH_TEMPLATE_ID=200
# Provider expects ten Indian national digits; the agent API still accepts +91 numbers.
VIH_PHONE_FORMAT=india_national
# Required for live mode after account-approved purpose: 3 promotional or 4 transactional.
VIH_CAMPAIGN_TYPE=
# Latest provider contract: the generated full URL is sent in msisdnlist[].param1.
# Replace bridge.example.com in BOTH PUBLIC_STREAM_BASE_URL and this template.
# Keep {callId} and {token} literal; VAH fills them for each call.
VIH_WSS_VALUE_MODE=confirmed_dynamic
VIH_WSS_VALUE=wss://bridge.example.com/calls/{callId}?token={token}
# Optional completion-reporting integration. Leave disabled for the WSS-only audio demo.
VIH_CDR_AUTH_MODE=disabled
VIH_CDR_SECRET=
# CDR may be received without response IDs; unmatched reports are stored without releasing reservations.
# Needed to reconcile CDR for calls that never open a stream; leave blank unless provider-confirmed.
# Confirmed JSON Pointer to ViH's returned call ID, e.g. /data/callSid.
VIH_RESPONSE_CALL_ID_PATH=
# Alternatively, confirmed campaign ID JSON Pointer. Safe only because this POC sends one recipient per campaign.
VIH_RESPONSE_CAMPAIGN_ID_PATH=
RECORDING_DIR=
MAX_FRAME_BYTES=16384
MAX_TRANSCRIPT_CHARS=32768
PERSONAPLEX_READY_TIMEOUT_SECONDS=15
# Initialize the full model prompt BEFORE dialing; fail without placing a call if not ready.
PERSONAPLEX_PREPARE_TIMEOUT_SECONDS=120
# SESSION_TTL_SECONDS above also bounds how long a ready model waits for the provider stream.
IDLE_TIMEOUT_SECONDS=60
CLOSE_TIMEOUT_SECONDS=5
MAX_CALL_SECONDS=1800
# ViH arrival-clock transport (service-owned; no per-call overrides).
MEDIA_INPUT_STARTUP_MS=60
MEDIA_INPUT_MAX_BUFFER_MS=1000
MEDIA_OUTPUT_MAX_BUFFER_MS=400
# Playback-only energy heuristic, NOT semantic VAD/ASR. Leave off until calibrated.
MEDIA_INTERRUPTION_MODE=off
MEDIA_INTERRUPTION_RMS=1000
MEDIA_INTERRUPTION_SUSTAIN_MS=400
MEDIA_INTERRUPTION_RELEASE_MS=300
